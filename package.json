{
  "name": "tic-tac-toe",
  "version": "1.3.0",
  "description": "多人井字棋游戏",
  "main": "1.js",
  "bin": "run_and_check.js",
  "scripts": {
    "start": "node 1.js",
    "build:config": "node scripts/generate-config.js",
    "build": "npm run build:config",
    "build:exe": "pkg . --out-path dist --targets node18-linux-x64",
    "build:exe:win": "pkg . --out-path dist --targets node18-win-x64",
    "build:exe:win32": "npx pkg@4.5.1 . --out-path dist --targets node14-win-x86",
    "build:exe:macos": "pkg . --out-path dist --targets node18-macos-x64"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "express": "^4.22.2",
    "socket.io": "^4.8.3"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  }
}